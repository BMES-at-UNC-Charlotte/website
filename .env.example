# After cloning, choose one:
# - With Vercel access: run `pnpm vercel:init`.
# - Without Vercel access: run `cp .env.example .env.local` and add the values.
#
# Vercel writes Development variables to `.env.local`; refresh them with
# `pnpm env:pull`. Put machine-specific overrides in `.env.development.local`.
#
# Keep this committed example free of secrets. When adding a variable, update
# this file, the Vercel project, and the schema in `/src/env.js`.

# Better Auth
# Public application origin used to construct OAuth callback URLs
BETTER_AUTH_URL="http://localhost:3000"
# Secret used to sign and encrypt Better Auth data
BETTER_AUTH_SECRET=""
# Google OAuth web client credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/charlotte-bmes-website"


# Stripe
# Publishable key - used for events needed in the frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Secret key - used for events needed in the backend
STRIPE_SECRET_KEY=""
# Signing secret for the /api/stripe/webhook endpoint
STRIPE_WEBHOOK_SECRET=""
# The active one-time Price IDs for each registration tier
STRIPE_TIER_1_PRICE_ID=""
STRIPE_TIER_2_PRICE_ID=""
STRIPE_TIER_3_PRICE_ID=""
# $50 one-time Price for each representative above the two included
STRIPE_ADDITIONAL_REP_PRICE_ID=""