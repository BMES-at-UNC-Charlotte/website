// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model User {
  id                String      @id
  name              String //@db.Text
  email             String
  emailVerified     Boolean     @default(false)
  image             String? //@db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt
  sessions          Session[]
  accounts          Account[]
  posts             Post[]
  adminUsersCreated AdminUser[] @relation("AdminUserAddedBy")
  adminUser         AdminUser?  @relation("AdminUserAccount")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum AdminRole {
  ADMIN
  OFFICER
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  createdAt     DateTime  @default(now())
  role          AdminRole @default(OFFICER)
  addedByUserId String?
  addedBy       User?     @relation("AdminUserAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  userId        String?   @unique
  user          User?     @relation("AdminUserAccount", fields: [userId], references: [id], onDelete: SetNull)

  @@index([addedByUserId])
  @@map("adminUsers")
}

model Survey {
  id        String   @id @default(cuid())
  comment   String   @default("") @map("description")
  path      String   @unique @db.VarChar(64)
  formUrl   String
  live      Boolean  @default(false)
  // A calendar date in America/New_York, inclusive through 11:59:59 PM.
  closesOn  String?  @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([closesOn])
}

enum DonationPaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
}

model DonationCheckout {
  id                      String                @id @default(cuid())
  idempotencyKey          String                @unique
  requestHash             String
  kind                    String
  tier                    String?
  stripePriceId           String?
  amount                  Int
  currency                String                @default("usd")
  sponsor                 Json?
  logoName                String?
  logoContentType         String?
  logoData                Bytes?
  stripeCheckoutSessionId String?               @unique
  stripePaymentIntentId   String?               @unique
  status                  DonationPaymentStatus @default(PENDING)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([status, createdAt])
}

model SponsorshipPrice {
  priceId String @id
}
